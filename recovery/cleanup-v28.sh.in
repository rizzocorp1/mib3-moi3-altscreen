#!/bin/sh
# Remove only byte-identified obsolete program copies, after verified USB backup.
# Keep factory metadata backups, reports, unknown files, directories and active stages.
set -u
stage=$1
usb=$2
R=${3:-}
BASE="$R/lge/app_rw/smartlink/carplay"
GUARD="$stage/file-guard"
REPORT="$usb/housekeeping-v28.txt"
[ "$stage" = "$BASE/.moi3-altscreen-map-v28" ] || exit 2
case "$usb" in "$R/tmp/USB/PORT1/PART1"|"$R/tmp/USB/PORT2/PART1") ;; *) exit 2;; esac
[ -d "$usb" ] && [ ! -L "$usb" ] && [ ! -L "$REPORT" ] || exit 2
matches() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    actual=$(sha256sum "$1" 2>/dev/null) || return 1
    [ "${actual%% *}" = "$2" ]
}
run() {
    echo 'MOI3 V28 READ-ONLY INVENTORY AND VERIFIED OBSOLETE-PROGRAM CLEANUP'
    matches "$GUARD" '@GUARD_SHA@' && matches "$BASE/carplay" '@CARPLAY_SHA@' && matches "$BASE/carplay.sh" '@STARTUP_SHA@' && matches "$stage/factory-carplay.sh" '@STARTUP_SHA@' || {
        echo 'CLEANUP REFUSED: factory baseline/helper verification failed; no deletions';return 1;
    }
    "$GUARD" same-meta "$stage/factory-carplay.sh" "$BASE/carplay.sh" || return 1
    echo 'BEFORE app_rw';"$GUARD" space "$BASE" || return 1
    if [ -d "$R/data" ] && [ ! -L "$R/data" ]; then echo 'BEFORE data';"$GUARD" space "$R/data" || return 1;fi
    "$GUARD" inventory "$BASE" || return 1
    archive="$usb/moi3-obsolete-programs-v28"
    if [ -e "$archive" ] || [ -L "$archive" ]; then
        [ -d "$archive" ] && [ ! -L "$archive" ] && [ -f "$archive/BACKUP_SCOPE.txt" ] && [ ! -L "$archive/BACKUP_SCOPE.txt" ] && [ "$(cat "$archive/BACKUP_SCOPE.txt")" = MOI3_OBSOLETE_TEST_PROGRAMS_V28 ] || {
            echo 'CLEANUP REFUSED: unknown backup directory; preserving all old programs';return 1;
        }
    else
        mkdir "$archive" || return 1
        (set -C;printf 'MOI3_OBSOLETE_TEST_PROGRAMS_V28\n' > "$archive/BACKUP_SCOPE.txt") || return 1
    fi
    reclaimed=0;removed=0;last_version='';eligible=0
    while IFS='|' read -r version name expected; do
        case "$version" in v6|v7|v8|v9|v10|v11|v12|v13|v14|v15|v16|v17|v18) ;; *) echo 'PRESERVED invalid version row';continue;; esac
        case "$name" in file-guard|packet-audit|carplay-once|altscreen_handler.so|managed-log-collector.sh|startup-new.sh) ;; *) echo 'PRESERVED invalid file row';continue;; esac
        case "$expected" in *[!0-9a-f]*) continue;; esac
        [ "${#expected}" = 64 ] || continue
        old="$BASE/.moi3-altscreen-map-$version"
        if [ "$last_version" != "$version" ]; then
            last_version=$version;eligible=0
            [ -d "$old" ] && [ ! -L "$old" ] || continue
            if systemctl is-active --quiet "moi3-altscreen-log-$version.service"; then
                printf 'PRESERVED active stage=%s\n' "$version";continue
            fi
            if matches "$old/factory-carplay.sh" '@STARTUP_SHA@' && "$GUARD" same-meta "$old/factory-carplay.sh" "$stage/factory-carplay.sh"; then eligible=1
            else printf 'PRESERVED stage=%s: baseline or metadata not verified\n' "$version";fi
        fi
        [ "$eligible" = 1 ] || continue
        source="$old/$name"
        [ -e "$source" ] || [ -L "$source" ] || continue
        matches "$source" "$expected" || continue
        bytes=$("$GUARD" size "$source") || continue
        case "$bytes" in ''|*[!0-9]*) continue;; esac
        if [ "$removed" -ge 24 ] || [ $((reclaimed+bytes)) -gt 33554432 ]; then
            echo 'CLEANUP BUDGET REACHED: maximum24 copies/32MiB per update; remaining copies preserved for a later verified pass'
            break
        fi
        backup_dir="$archive/$version"
        if [ ! -e "$backup_dir" ] && [ ! -L "$backup_dir" ]; then mkdir "$backup_dir" || continue;fi
        [ -d "$backup_dir" ] && [ ! -L "$backup_dir" ] || continue
        backup="$backup_dir/$name.$expected.backup"
        if [ -e "$backup" ] || [ -L "$backup" ]; then matches "$backup" "$expected" || { echo 'PRESERVED conflicting backup';continue; }
        else cp "$source" "$backup" || { echo 'PRESERVED copy failure';continue; };fi
        matches "$backup" "$expected" && matches "$source" "$expected" || { echo 'PRESERVED backup/source verification failure';continue; }
        bytes=$("$GUARD" size "$source") || continue
        case "$bytes" in ''|*[!0-9]*) continue;; esac
        # Literal, fixed basename inside a validated stage. Never recursive delete.
        if rm -f "$source"; then
            reclaimed=$((reclaimed+bytes));removed=$((removed+1))
            printf 'REMOVED verified obsolete copy version=%s file=%s bytes=%s\n' "$version" "$name" "$bytes"
        fi
    done <<'VERIFIED_PROGRAM_ROWS'
v10|altscreen_handler.so|d2650b706b39dd89ab56782e1256064d836d92a0c3e1a4fb291b99476b765a04
v10|carplay-once|fed2f6c892df6a8e037b40b6e9ffcf1a507f92b86a96c5ad6fb2a508dc242f13
v10|file-guard|1a8b923f973e34e8a8521763b411a9f72840b5cf4551824e59df3959a21cc930
v10|file-guard|2de15cea8f77fe1bd224c128dbaa8c873219900c7954225eeb9cbecb8ec7b157
v10|file-guard|8f75dfd89cd1fab58d31c814c6b45badb004f22d8dc2a888381cb3f065946e25
v10|file-guard|98638c0934182b24735b5633d005dbde7e8bb978246e4b14c4d7c6eb7e929c4d
v10|managed-log-collector.sh|3e871595be7fa01f1fce58ed2bad17645d17e821fa8c0eb1b2677fa252434226
