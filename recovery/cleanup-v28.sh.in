    printf 'CLEANUP COMPLETE removedCopies=%s logicalBytesRemoved=%s; factory backups/reports/unknown files retained\n' "$removed" "$reclaimed"
    echo 'AFTER app_rw';"$GUARD" space "$BASE"
    if [ -d "$R/data" ] && [ ! -L "$R/data" ]; then echo 'AFTER data';"$GUARD" space "$R/data";fi
    "$GUARD" inventory "$BASE"
}
run > "$REPORT" 2>&1
